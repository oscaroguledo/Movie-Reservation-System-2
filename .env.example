# Copy this to .env and fill in real values before `docker compose up`.

# Postgres
POSTGRES_DB=auth_api
POSTGRES_USER=auth_api
POSTGRES_PASSWORD=change-me

# auth-api — JWT_SECRET_KEY must be at least 32 bytes and unique per
# environment; never reuse the dev default baked into application.yml.
JWT_SECRET_KEY=change-me-to-a-real-random-secret-32-bytes-minimum
JWT_ACCESS_TOKEN_TTL_MINUTES=30

# Per-IP sliding-window rate limit on /auth/register and /auth/login.
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Bootstraps the first admin account on startup — the only way to get an
# initial admin, since every admin-management endpoint otherwise requires
# one to already exist. Leave both blank (the default) to skip seeding.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=Admin
INITIAL_ADMIN_LAST_NAME=User

# How often the background job purges revoked_tokens rows whose own
# token has already expired.
REVOKED_TOKEN_CLEANUP_INTERVAL_SECONDS=3600

# movie-api — validates JWTs auth-api issues, so it reuses JWT_SECRET_KEY
# above rather than defining its own.
HOLD_TTL_SECONDS=30
ENTITY_CACHE_TTL_SECONDS=3600

# Per-IP sliding-window rate limit on POST /reservations.
RESERVATION_RATE_LIMIT_MAX_REQUESTS=20
RESERVATION_RATE_LIMIT_WINDOW_SECONDS=60
